# resetting the alpha surface after mode switches so the hovers don't break.
def toggle_fullscreen():
    global screen, is_fullscreen, hover_surface
    is_fullscreen = not is_fullscreen
    if is_fullscreen:
        screen = pygame.display.set_mode((1152, 648), pygame.FULLSCREEN)
    else:
        screen = pygame.display.set_mode((1152, 648))
    hover_surface = pygame.Surface((1152, 648), pygame.SRCALPHA)

def draw_hover(btn_rect):
    # clearing out the old glow before drawing a new one so the screen doesn't get flooded with overlapping rectangles as the mouse moves around
    hover_surface.fill((0, 0, 0, 0))
    pygame.draw.rect(hover_surface, (255, 255, 255, 50), btn_rect, border_radius=6)
    screen.blit(hover_surface, (0, 0))

