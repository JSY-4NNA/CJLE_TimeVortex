    pygame.draw.line(screen, arrow_col, (cx+6, cy-4), (cx+6, cy-1), 2)

def load_gif(path):
# splits a GIF into standard Pygame-friendly frames and caches them."""
    gif = Image.open(path)
    frames = []
    for f in range(gif.n_frames):
        gif.seek(f)
        # converting to RGBA format so any transparent canvas backgrounds in the original GIFs are the same
        frame_img = gif.convert("RGBA")
        pygame_frame = pygame.image.fromstring(frame_img.tobytes(), frame_img.size, "RGBA")
        pygame_frame = pygame.transform.scale(pygame_frame, (1152, 648))
        frames.append(pygame_frame)
    return frames

