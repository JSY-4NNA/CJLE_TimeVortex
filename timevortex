import pygame
import sys
from PIL import Image

pygame.init()
screen = pygame.display.set_mode((1152, 648))
clock = pygame.time.Clock()

def load_gif(path):
    gif = Image.open(path)
    frames = []
    for f in range(gif.n_frames):
        gif.seek(f)
        frame_img = gif.convert("RGBA")
        pygame_frame = pygame.image.fromstring(frame_img.tobytes(), frame_img.size, "RGBA")
        pygame_frame = pygame.transform.scale(pygame_frame, (1152, 648))
        frames.append(pygame_frame)
    return frames

current_screen = "intro"
frames = load_gif("./introduction.gif")
frame_index = 0
frame_timer = 0
FRAME_DELAY = 3
waiting_for_click = False

menu_img = pygame.image.load("./menu.png")
menu_img = pygame.transform.scale(menu_img, (1152, 648))

btn_1960 = pygame.Rect(26, 200, 336, 350)
btn_1970 = pygame.Rect(404, 200, 336, 350)
btn_1980 = pygame.Rect(793, 200, 336, 350)
btn_1960_continue = pygame.Rect(900, 560, 180, 80)
btn_1970_continue = pygame.Rect(900, 560, 180, 80)
btn_1980_continue = pygame.Rect(900, 560, 180, 80)
def go_to(screen_name):
    global current_screen, frames, frame_index, frame_timer, waiting_for_click
    current_screen = screen_name
    frames = load_gif(f"./{screen_name}.gif")
    frame_index = 0
    frame_timer = 0
    waiting_for_click = False
    
while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()
        if event.type == pygame.MOUSEBUTTONDOWN:
            print(f"clicked at: {event.pos}, screen: {current_screen}")
            if current_screen == "menu":
                if btn_1960.collidepoint(event.pos):
                    print("1960 clicked!")
                    go_to("1960_mission1")
                elif btn_1970.collidepoint(event.pos):
                    print("1970 clicked!")
                    go_to("1970_mission1")
                elif btn_1980.collidepoint(event.pos):
                    print("1980 clicked!")
                    go_to("1980_mission1")
            if current_screen == "1960_mission1" and waiting_for_click:
                if btn_1960_continue.collidepoint(event.pos):
                    print("continue clicked!")
                    go_to("1960_question1")
            if current_screen == "1970_mission1" and waiting_for_click:
                if btn_1970_continue.collidepoint(event.pos):
                    print("continue clicked!")
                    go_to("1970_question1")
            if current_screen == "1980_mission1" and waiting_for_click:
                if btn_1980_continue.collidepoint(event.pos):
                    print("continue clicked!")
                    go_to("1980_question1")

    if current_screen in ("intro", "1960_mission1","1970_mission1","1980_mission1","1960_question1","1970_question1","1980_question1") and not waiting_for_click:
        frame_timer += 1
        if frame_timer >= FRAME_DELAY:
            frame_timer = 0
            frame_index += 1
            if current_screen == "intro":
                if frame_index >= len(frames):
                    current_screen = "menu"
                    frame_index = len(frames) - 1
            elif current_screen in ("1970_mission1", "1980_mission1", "1960_question1", "1970_question1", "1980_question1"):
                if frame_index >= len(frames):
                    frame_index = len(frames) - 1
                    waiting_for_click = True

    if current_screen == "intro":
        screen.blit(frames[frame_index], (0, 0))
    elif current_screen == "menu":
        screen.blit(menu_img, (0, 0))
    elif current_screen in ("1960_mission1","1970_mission1","1980_mission1","1960_question1","1970_question1","1980_question1"):
        screen.blit(frames[frame_index], (0, 0))
    elif current_screen == "white":
        screen.fill((255, 255, 255))

    pygame.display.flip()
    clock.tick(60)